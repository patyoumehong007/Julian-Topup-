# ===== ចាំបាច់ =====
# ពាក្យសម្ងាត់ចូល /admin (ដាក់ឱ្យវែង ពិបាកទាយ)
ADMIN_PASSWORD=change-me-to-a-long-password

# Database: Vercel -> Storage -> Upstash Redis -> Connect Project  (ដាក់ env ទាំងនេះឱ្យស្វ័យប្រវត្តិ)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (ឬឈ្មោះ UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN ក៏បាន)

# ===== ជម្រើស =====
# ផ្ទៀងផ្ទាត់ KHQR ស្វ័យប្រវត្តិ (Bakong Open API token ពី https://api-bakong.nbc.gov.kh)
BAKONG_TOKEN=
# ជូនដំណឹងបញ្ជាទិញចូល Telegram (បង្កើត bot ជាមួយ @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ឆែកឈ្មោះគណនីហ្គេម (Vizo API key ពី Telegram bot @vizooo_bot → /account)
VIZO_API_KEY=
# សោសម្រាប់ចុះហត្ថលេខា session Admin (ទុកទទេបាន)
ADMIN_SECRET=
